{
  "name": "@nnrp/native-client",
  "version": "1.0.0-preview.4.6",
  "description": "Node.js and Deno native client SDK for NNRP.",
  "keywords": [
    "nnrp",
    "ai",
    "runtime",
    "client",
    "native",
    "typescript"
  ],
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NagareWorks/nnrp-js.git",
    "directory": "packages/native-client"
  },
  "bugs": {
    "url": "https://github.com/NagareWorks/nnrp-js/issues"
  },
  "homepage": "https://github.com/NagareWorks/nnrp-js/tree/main/packages/native-client#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./experimental/*": null,
    "./internal/*": null
  },
  "files": [
    "README.md",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/index.d.ts.map"
  ],
  "dependencies": {
    "@nnrp/core": "workspace:*"
  },
  "peerDependencies": {
    "@nnrp/transport-ipc": "workspace:*",
    "@nnrp/transport-quic": "workspace:*",
    "@nnrp/transport-tcp": "workspace:*",
    "@nnrp/transport-websocket": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@nnrp/transport-ipc": {
      "optional": true
    },
    "@nnrp/transport-quic": {
      "optional": true
    },
    "@nnrp/transport-tcp": {
      "optional": true
    },
    "@nnrp/transport-websocket": {
      "optional": true
    }
  },
  "nnrp": {
    "runtimeTargets": ["node>=20.11", "deno>=2"]
  }
}
